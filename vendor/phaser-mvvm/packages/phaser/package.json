  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@phaser-mvvm/core": "workspace:*",
    "@phaser-mvvm/layout": "workspace:*"
  },
  "peerDependencies": {
    "phaser": "^4.2.0"
  },
  "private": true
}
